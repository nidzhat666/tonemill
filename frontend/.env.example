# Server-only: internal address of the Tonemill API (e.g. http://api:8000 inside Docker).
# Never exposed to the browser -- see src/routes/api/[...path]/+server.ts.
TONEMILL_API_BASE_URL=http://localhost:8000

# Shared-login gate (see src/hooks.server.ts). Leave both unset to disable the gate, e.g. for
# local development -- required in any deployment reachable outside a trusted network.
TONEMILL_AUTH_USERNAME=
TONEMILL_AUTH_PASSWORD=
