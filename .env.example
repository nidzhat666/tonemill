# Production docker-compose.yml env vars -- copy to .env and fill in for your existing
# self-hosted MinIO (or real AWS S3).

# Internal endpoint the API/worker containers use directly (create/complete/abort/list/
# head/upload/download).
TONEMILL_S3_ENDPOINT_URL=https://minio.example.internal

# Only set this if your MinIO's browser-facing address differs from the internal one above
# (e.g. an internal hostname vs. a public one behind a reverse proxy). Presigned URLs must
# resolve from the client's browser, not just from the API container. Leave unset if the
# same URL works from both places (e.g. real AWS S3).
# TONEMILL_S3_PUBLIC_ENDPOINT_URL=https://minio.example.com

TONEMILL_S3_ACCESS_KEY_ID=
TONEMILL_S3_SECRET_ACCESS_KEY=
TONEMILL_S3_BUCKET=tonemill

# Job/upload-session retention (seconds). Default: 24h.
TONEMILL_JOB_TTL_SECONDS=86400

# GPU worker concurrency (FR-018): default 1, at most 2, per GPU.
TONEMILL_GPU_CONCURRENCY=1
